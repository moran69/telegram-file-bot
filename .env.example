# Copy to .env locally. Do not commit or share credentials.
API_ID=
API_HASH=
BOT_TOKEN=
# Telegram user IDs (comma separated). Only admins may run administrative commands.
ADMIN_IDS=
# Additional users who may submit links/forwarded posts, without admin rights.
SUBMITTER_IDS=
FORWARD_TO_CHAT_ID=
MONITOR_CHAT_IDS=
USER_MONITOR_ENABLED=1
USER_SESSION_STRING=
TZ=Asia/Shanghai
AUTO_DELETE_BOT_MESSAGES=1
AUTO_DELETE_STATUS_SECONDS=300
AUTO_DELETE_COMMAND_SECONDS=120
AUTO_DELETE_ERROR_SECONDS=600
