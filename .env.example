# 首次配置时，将本文件复制为 .env，再填写凭据。不要提交或分享填写后的 .env。

# Telegram API 凭据：在 my.telegram.org 的「API development tools」页面获取。
API_ID=
API_HASH=
# 机器人令牌：由 Telegram 的 @BotFather 提供，不是上面的 API_HASH。
BOT_TOKEN=

# 管理员的 Telegram 用户 ID。只有管理员可以执行管理命令；多个 ID 用英文逗号分隔。
ADMIN_IDS=
# 允许提交链接或转发消息的其他用户 ID，用英文逗号分隔。留空时仅管理员可投稿。
SUBMITTER_IDS=

# 默认接收转发消息的目标频道 ID，接受频道裸 ID 或 Telegram 标记后的频道 ID。
FORWARD_TO_CHAT_ID=
# 自动监听的源频道裸 ID（不带 -100 前缀）；多个 ID 用英文逗号分隔。
MONITOR_CHAT_IDS=
# 已确认的消息映射保留天数。每 7 天清理一次；设为 0 则永久保留。
# 映射清除后，旧帖的编辑不再同步，但不会删除 Telegram 上的消息。
MONITOR_MAP_RETENTION_DAYS=7
# 使用用户账号监听源频道：1 启用，0 禁用并改用机器人监听。
USER_MONITOR_ENABLED=1
# 用户账号的 Telethon 会话字符串，可用 gen_telethon_session.py 生成。请勿泄露。
USER_SESSION_STRING=

# 容器时区。
TZ=Asia/Shanghai
# 自动清理机器人的状态提示和相关命令消息：1 启用，0 禁用。以下延迟均以秒为单位：留空使用默认值，0 不删除该类消息。
AUTO_DELETE_BOT_MESSAGES=1
# 普通状态提示的保留时间。
AUTO_DELETE_STATUS_SECONDS=300
# 命令消息的保留时间。
AUTO_DELETE_COMMAND_SECONDS=120
# 错误提示的保留时间。
AUTO_DELETE_ERROR_SECONDS=600
